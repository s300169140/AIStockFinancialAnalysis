# Server
PORT=3001
NODE_ENV=production

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/aistock

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=replace-me-with-64-hex-characters

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Google Sign-In — Web client ID from Google Cloud Console
# (Android client ID is also created but only Web client ID is verified server-side)
GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com

# Google Play Billing
# Path to service account JSON downloaded from Google Cloud Console with
# "Android Publisher" role granted in Play Console.
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/aistock/service-account.json
ANDROID_PACKAGE_NAME=com.aistock.analysis
PRO_SUBSCRIPTION_PRODUCT_ID=pro_monthly

# Trial
TRIAL_LIMIT=3

# RTDN webhook auth (use Pub/Sub push with an auth token)
RTDN_SHARED_SECRET=replace-me
